# TypeSafe AI API Configuration
# Get early access key from TypeSafe AI: https://typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional configuration overrides:
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Gmail Integration (for examples/05_email_classifier.py):
# Generate an App Password at https://myaccount.google.com/apppasswords
# GMAIL_EMAIL=your_email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Set to true to always use mock data without connecting to Gmail:
# MOCK_EMAILS=true
